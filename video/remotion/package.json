{
  "name": "scan-film-remotion",
  "private": true,
  "version": "1.0.0",
  "description": "Remotion workspace for the pre-rendered cut of 'The Scan That Changed Everything'. Reads ../../shared/story.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ScanFilm out/the-scan-that-changed-everything.mp4",
    "render:vertical": "remotion render src/index.ts ScanFilmVertical out/the-scan-vertical.mp4",
    "still": "remotion still src/index.ts ScanFilm out/still.png --frame=120",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.541",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.541"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
